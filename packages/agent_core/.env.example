# ===== 智效工坊 AI 引擎环境变量模板 =====
# 引擎进程
ENGINE_HOST=0.0.0.0
ENGINE_PORT=8001
ENGINE_DEBUG=true
LOG_LEVEL=INFO

# LLM（按需启用）
LLM_PROVIDER=deepseek              # openai | deepseek | dashscope
LLM_MODEL_NAME=deepseek-chat
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=please_change_me
LLM_FALLBACK_MODEL=qwen-max
LLM_FALLBACK_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_FALLBACK_API_KEY=
LLM_RPM=300
LLM_TPM=300000
LLM_TIMEOUT=30

# Embedding
EMBEDDING_PROVIDER=local          # local | openai
EMBEDDING_MODEL=bge-large-zh-v1.5
EMBEDDING_DIM=1024
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=

# Chroma
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=knowledge_vectors

# Redis（与后端共用）
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 业务红线
REVIEW_MAX_ROUNDS=2
TASK_TOTAL_TIMEOUT_SEC=1800
TOOL_RETRY_TIMES=3
LLM_OUTPUT_MAX_TOKENS=4096