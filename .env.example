APP_ENV=dev
APP_DEBUG=false
LOG_LEVEL=INFO
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=zhixiao
MYSQL_USER=zhixiao
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root_me
MINIO_ROOT_USER=zhixiao_minio
MINIO_ROOT_PASSWORD=change_minio_me
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-random-redis-password
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-at-least-32-random-characters
WORKER_CALLBACK_TOKEN=replace-with-a-separate-random-worker-token
WORKER_JOB_SIGNING_SECRET=replace-with-a-separate-random-job-signing-secret
CORS_ORIGINS=http://localhost:5173

LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_BASE=
LLM_FALLBACK_API_KEY=

VECTOR_BACKEND=chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace_me

RUNNER_BACKEND=bubblewrap
RUNNER_ROOT=./workspaces
WORKSPACE_BASE=./workspaces
WORKSPACE_SOURCE_ROOTS=./workspaces
RUNNER_NETWORK=none
ALLOW_UNSANDBOXED_LOCAL_EXECUTION=false
COMMAND_TIMEOUT_SECONDS=120
REQUIRE_APPROVAL_FOR_WRITES=true
