# ===== 智效工坊后端环境变量模板 =====
# 应用
APP_NAME=zhixiao-backend
APP_ENV=dev                      # dev / test / prod
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
LOG_LEVEL=INFO

# MySQL 8.0
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=zhixiao
MYSQL_PASSWORD=zhixiao_pwd
MYSQL_DATABASE=zhixiao
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=20
MYSQL_POOL_RECYCLE=3600

# Redis 7.0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Chroma 向量库
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=knowledge_vectors
VECTOR_DIM=1024

# JWT 鉴权
JWT_SECRET=please_change_me_in_prod           # 生产环境必须改为高熵随机串
JWT_ISSUER=zhixiao
JWT_ACCESS_TTL_MIN=30                          # access token 有效期
JWT_REFRESH_TTL_DAY=30                         # refresh token 有效期

# 限流
RATE_LIMIT_LOGIN_FAIL=5                         # 15min 内最大失败次数
RATE_LIMIT_TASK_CREATE_PER_MIN=30               # 每分钟每空间最多创建任务数

# AI 引擎调用 (实际 SDK 实现见 GOAL-03)
AI_ENGINE_BASE_URL=http://localhost:8001       # 引擎进程地址（也可在进程内 import 同一项目）
AI_ENGINE_TIMEOUT=120
WORKER_CALLBACK_TOKEN=replace_with_a_shared_random_token

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:80
