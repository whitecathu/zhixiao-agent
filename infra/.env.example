# ===== 智效工坊 部署 .env 模板 =====
# 标记敏感项 (* 必填) - 生产请通过运维平台 / Vault / env_file 注入
# 千万不要提交真实的 .env 文件到 git

# --- 应用 ---
APP_ENV=prod
APP_DEBUG=false
LOG_LEVEL=WARNING

# --- MySQL ---
MYSQL_DATABASE=zhixiao
MYSQL_USER=zhixiao
MYSQL_PASSWORD=zhixiao_prod_pwd_change_me     # *
MYSQL_ROOT_PASSWORD=root_prod_pwd_change_me     # *
MYSQL_PORT_PUBLISH=3306

# --- Redis ---
REDIS_PASSWORD=
REDIS_PORT_PUBLISH=6379

# --- Chroma ---
CHROMA_PORT_PUBLISH=8000
CHROMA_COLLECTION=knowledge_vectors

# --- JWT ---
JWT_SECRET=use_a_long_random_string_in_prod     # *

# --- LLM/AI 引擎 ---
LLM_PROVIDER=deepseek
LLM_MODEL_NAME=deepseek-chat
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=                                    # *
LLM_FALLBACK_API_BASE=
LLM_FALLBACK_API_KEY=
LLM_RPM=300
LLM_TPM=300000

# --- Embedding ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=bge-large-zh-v1.5
EMBEDDING_DIM=1024

# --- 对外端口映射 ---
WEB_PORT_PUBLISH=80
BACKEND_PORT_PUBLISH=8000
AI_PORT_PUBLISH=8001

# --- CORS（逗号分隔）-----
CORS_ORIGINS=https://zhixiao.example.com

# --- 限流 ---
RATE_LIMIT_TASK_CREATE_PER_MIN=30
RATE_LIMIT_LOGIN_FAIL=5